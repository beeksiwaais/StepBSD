<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  org.stepbsd.boot

  Once per boot: the run-time linker hints the GNUstep libraries need, and on
  the first boot the caches FreeBSD package post-installs would build. See
  /usr/local/libexec/stepbsd/boot.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.stepbsd.boot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/stepbsd/boot</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
