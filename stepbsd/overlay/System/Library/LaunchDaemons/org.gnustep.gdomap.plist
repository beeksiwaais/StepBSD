<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  org.gnustep.gdomap

  The GNUstep Distributed Objects name server (port 538), which the desktop's
  services register through (dshelper among them). -f keeps it in the
  foreground so launchd tracks the real process; without it gdomap forks, the
  parent exits and KeepAlive respawns it against the port it still holds.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.gnustep.gdomap</string>
    <key>ProgramArguments</key>
    <array>
        <string>/System/Library/Tools/gdomap</string>
        <string>-f</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
