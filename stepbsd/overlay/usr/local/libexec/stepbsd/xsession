#!/bin/sh
#
# The StepBSD X session: Window Maker as the window manager, GWorkspace as the
# GNUstep Workspace Manager. Run by startstep through startx; ~/.xsession, if
# present and executable, replaces it entirely.

if [ -x "$HOME/.xsession" ]; then
	exec "$HOME/.xsession"
fi

. /usr/local/GNUstep/System/Library/Makefiles/GNUstep.sh

# The session's output, and its programs' stderr, go to a log.
mkdir -p "$HOME/GNUstep/Library/Logs"
exec >"$HOME/GNUstep/Library/Logs/xsession.log" 2>&1

/usr/local/bin/xsetroot -solid '#505075'

# First login: Window Maker's stock defaults, then the StepBSD dock, which
# holds the GNUstep applications and launches GWorkspace (the Workspace
# Manager, which also draws the desktop) when Window Maker starts.
if [ ! -d "$HOME/GNUstep/Library/WindowMaker" ]; then
	/usr/local/bin/wmaker.inst --batch
fi
if [ ! -f "$HOME/GNUstep/Defaults/WMState" ]; then
	mkdir -p "$HOME/GNUstep/Defaults"
	cp /usr/local/share/stepbsd/WMState "$HOME/GNUstep/Defaults/WMState"
fi

exec /usr/local/bin/wmaker
