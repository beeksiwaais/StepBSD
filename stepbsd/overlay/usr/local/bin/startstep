#!/bin/sh
#
# startstep — start the StepBSD desktop: the X server, Window Maker and
# GWorkspace (see /usr/local/libexec/stepbsd/xsession).
#
# Login shells on the first virtual console run this automatically
# (/usr/local/etc/stepbsd/profile.sh); `touch ~/.stepbsd-nodesktop` turns
# that off. Extra arguments go to the X server, e.g. `startstep vt9`.

if [ -n "${DISPLAY:-}" ]; then
	echo "startstep: already running under X (DISPLAY=$DISPLAY)" >&2
	exit 1
fi

exec /usr/local/bin/startx /usr/local/libexec/stepbsd/xsession -- -nolisten tcp "$@"
