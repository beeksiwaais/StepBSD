Origin: NextBSD
Description: Find the X server and X tools in /usr/X11 too.
 NextBSD keeps its X11 stack in /usr/X11 (E23; NextBSD-xlibre, -xlibs), not
 in FreeBSD ports' /usr/local. LoginWindow looked for X/Xorg only in
 /usr/local/bin and /usr/bin, so it could not start a server; it, the
 Keyboard and Mouse preference panes now try /usr/X11/bin first for X,
 Xorg, setxkbmap, xkbcomp and xinput, keeping every existing path after it.

diff -ru a/LoginWindow/KeyboardManager.m b/LoginWindow/KeyboardManager.m
--- a/LoginWindow/KeyboardManager.m
+++ b/LoginWindow/KeyboardManager.m
@@ -450,6 +450,7 @@
 static const char *findSetxkbmap(void)
 {
     static const char *paths[] = {
+        "/usr/X11/bin/setxkbmap",
         "/usr/local/bin/setxkbmap",
         "/usr/bin/setxkbmap",
         "/bin/setxkbmap",
@@ -466,6 +467,7 @@
 static const char *findXkbcomp(void)
 {
     static const char *paths[] = {
+        "/usr/X11/bin/xkbcomp",
         "/usr/local/bin/xkbcomp",
         "/usr/bin/xkbcomp",
         "/bin/xkbcomp",
