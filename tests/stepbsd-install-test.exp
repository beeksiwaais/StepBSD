#!/usr/bin/expect -f
#
# stepbsd-install-test.exp — drive one phase of tests/stepbsd-install-test.sh
# over the serial console.
#
# usage: stepbsd-install-test.exp <harness-dir> <phase> qemu-system-x86_64 <args...>
#
#   install  live ISO (UEFI): interrupt the loader for a serial console, let
#            the live `admin` autologin land, install onto vtbd0 with
#            NextBSD's installer (its unattended backend, do-install.sh, the
#            one the nextbsd-installer TUI runs), add a serial-console loader
#            fragment to the installed root (so phase `check` can be driven),
#            power off.
#   check    installed disk (amd64: BIOS boot, pmbr + gptboot; arm64: UEFI):
#            verify the root, GNUstep at run time and the launchd jobs, remove
#            the serial fragment again (so phase `gui` boots like a real
#            machine), power off.
#
# Loader handling comes from the nextbsd-ci harness (patterns.tcl,
# loader.exp.inc) at the tag tests/stepbsd-install-test.sh pins.

set harness [lindex $argv 0]
set phase   [lindex $argv 1]
set qemu    [lrange $argv 2 end]

source "$harness/patterns.tcl"
source "$harness/loader.exp.inc"

log_user 1
set timeout 600

proc fail {msg} {
    puts "\nSTEPBSD-TEST-FAIL: $msg"
    exit 1
}

# Wait for the session the console getty gives us: NextBSD logs the
# password-less `admin` in automatically and greets it with nextbsd-fetch's
# banner; fall back to typing the name at a login prompt.
proc await_shell {secs} {
    global timeout re_panic re_session_msg re_fetch_banner
    set timeout $secs
    expect {
        timeout { fail "no login session within ${secs}s" }
        -re $re_panic { fail "kernel panic" }
        -re $re_session_msg { }
        -re $re_fetch_banner { }
        "login:" { send "admin\r"; exp_continue }
        "Password:" { send "\r"; exp_continue }
        # A login by name prints no banner. Its prompt is coloured (escape
        # sequences between user, host and directory) and console messages
        # can follow it, so wait for what zsh's line editor sends when it
        # shows a prompt: bracketed paste on, ESC [ ? 2004 h.
        -re {\[\?2004h} { }
    }
    sleep 3
    set timeout 60
    send "\r"
    send "echo STEP-READY-\$((40+2))\r"
    expect {
        timeout { fail "shell did not answer" }
        "STEP-READY-42" { }
    }
}

# Run a command line in the guest shell, return its exit status. The marker
# is matched only with a number after it, so the echoed command line (which
# carries the literal $?) never matches.
set n 0
proc run {cmd {secs 120}} {
    global timeout n
    incr n
    set timeout $secs
    sleep 0.3
    expect *
    send -- "$cmd; echo STEP-RC-$n=\$?\r"
    expect {
        timeout { fail "timed out after ${secs}s: $cmd" }
        -re "STEP-RC-$n=(\[0-9\]+)" { return $expect_out(1,string) }
    }
}

proc must {cmd {secs 120}} {
    set rc [run $cmd $secs]
    if {$rc != 0} { fail "exit $rc: $cmd" }
    puts "\nSTEPBSD-TEST-OK: $cmd"
}

proc power_off {} {
    global timeout
    send -- "echo | sudo -S -p '' poweroff\r"
    set timeout 180
    expect {
        timeout { fail "guest did not power off" }
        eof { }
    }
    puts "\nSTEPBSD-TEST-OK: powered off"
}

set sudo "echo | sudo -S -p ''"

spawn {*}$qemu

switch -- $phase {
    install {
        loader_prompt 120
        loader_set "set console=comconsole"
        loader_set "set boot_serial=YES"
        loader_set "set comconsole_speed=115200"
        loader_set "set boot_mutemsgs=NO"
        loader_boot "boot -v"
        await_shell 600

        must "cat /etc/os-release | grep -q '^NAME=\"StepBSD\"'"
        must "test -x /usr/sbin/nextbsd-installer"
        must "$sudo /usr/libexec/nextbsd-installer/do-install.sh -d vtbd0" 2400
        must "$sudo gpart show -l vtbd0"
        # NextBSD's root has no /mnt.
        must "mkdir -p /tmp/target && $sudo mount /dev/ufs/NEXTBSD /tmp/target"
        must "$sudo sh -c 'printf \"console=\\\"comconsole,vidconsole\\\"\\nboot_multicons=\\\"YES\\\"\\nboot_serial=\\\"YES\\\"\\ncomconsole_speed=\\\"115200\\\"\\nboot_mutemsgs=\\\"NO\\\"\\n\" > /tmp/target/boot/loader.conf.d/zz-ci-serial.conf'"
        must "$sudo umount /tmp/target"
        power_off
    }
    check {
        await_shell 600

        must "grep -q '^NAME=\"StepBSD\"' /etc/os-release"
        # Root is the installed disk (nextbsd-installer labels it NEXTBSD),
        # filling the 16 GiB disk.
        must "mount -p | awk '\$2 == \"/\"' | grep -q '^/dev/ufs/NEXTBSD'"
        must "df -k / | awk 'NR == 2 { exit !(\$2 > 8 * 1024 * 1024) }'"
        # The desktop is StepBSD-desktop from the StepBSD repository; every
        # package comes from NextBSD's or StepBSD's, none from FreeBSD's (E24).
        must "pkg info -e StepBSD-desktop && test \"\$(pkg query %R StepBSD-desktop)\" = StepBSD"
        must "test ! -e /usr/local/etc/pkg/repos/FreeBSD.conf && test -z \"\$(pkg query %R | grep -v -x -e NextBSD -e StepBSD)\""
        must "grep -q 'releases/download/packages-' /usr/local/etc/pkg/repos/StepBSD.conf"
        # Every library the desktop's programs need resolves at run time.
        # (Not Xorg: it is setuid, rtld ignores ldd's trace variable for it as
        # a user and it would start; the image build's closure check covers it.)
        foreach prog {
            /System/Applications/Workspace.app/Workspace
            /System/Applications/SystemPreferences.app/SystemPreferences
            /System/Applications/Terminal.app/Terminal
            /System/Applications/TextEdit.app/TextEdit
            /System/Library/CoreServices/Applications/LoginWindow.app/LoginWindow
            /System/Library/CoreServices/Applications/Menu.app/Menu
            /System/Library/CoreServices/Applications/WindowManager.app/WindowManager
            /System/Library/Tools/dshelper
        } {
            must "test -x $prog && ! ldd $prog | grep 'not found'"
        }
        # gnustep-base loads (rtld checks symbol versions; ldd does not) and
        # works, and reads Gershwin's system defaults.
        # A console login by name has HOME=/ (NextBSD creates homes on its
        # automatic login, which LoginWindow turns off), so give the probes one.
        must "export HOME=/tmp/stepbsd-test && mkdir -p \$HOME && . /System/Library/Makefiles/GNUstep.sh && defaults write StepBSDTest probe 42 && defaults read StepBSDTest probe | grep -qw 42"
        must "export HOME=/tmp/stepbsd-test && . /System/Library/Makefiles/GNUstep.sh && ! defaults read NSGlobalDomain 2>&1 | grep -q 'writable by someone other'"
        # System LaunchDaemons are listed in launchd's system domain (root's),
        # as on Darwin; a user's launchctl lists its own domain.
        must "$sudo launchctl list > /tmp/jobs && grep -q org.gnustep.gdomap /tmp/jobs && grep -q io.github.gershwin-desktop.dshelper /tmp/jobs && grep -q io.github.gershwin-desktop.loginwindow /tmp/jobs"
        must "$sudo rm /boot/loader.conf.d/zz-ci-serial.conf"
        power_off
    }
    default {
        fail "unknown phase $phase"
    }
}

puts "\nSTEPBSD-TEST-PASS: $phase"
exit 0
